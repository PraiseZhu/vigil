#!/usr/bin/env node
// 沙箱里的 gh（#47）：只放行 `gh api graphql --input -`，转成 read.graphql 动作交给写闸。
// 其它任何调用一律拒绝；GH_TOKEN 看都不看（沙箱里根本没有真令牌）。
import net from 'node:net';

const REFUSE = '沙箱里只允许经写闸读';

function refuse(message = REFUSE) {
  process.stderr.write(`${message}\n`);
  process.exit(1);
}

function send(socketPath, payload) {
  return new Promise((resolve, reject) => {
    const socket = net.connect(socketPath);
    let buffer = '';
    socket.on('connect', () => socket.write(`${payload}\n`));
    socket.on('data', (chunk) => {
      buffer += chunk;
    });
    socket.on('end', () => resolve(buffer));
    socket.on('error', reject);
  });
}

async function readStdin() {
  let text = '';
  for await (const chunk of process.stdin) text += chunk;
  return text;
}

async function main() {
  const args = process.argv.slice(2);
  const isGraphqlRead = args[0] === 'api' && args[1] === 'graphql' && args.includes('--input');
  if (!isGraphqlRead) refuse();
  const socketPath = process.env.ACCEPTANCE_GATE_SOCKET;
  if (!socketPath) refuse();

  const raw = await readStdin();
  let payload;
  try {
    payload = JSON.parse(raw || '{}');
  } catch {
    refuse('读请求不是合法 JSON');
  }
  const action = {
    type: 'read.graphql',
    query: payload.query,
    variables: payload.variables || {},
  };
  let reply;
  try {
    reply = await send(socketPath, JSON.stringify(action));
  } catch (error) {
    refuse(`连不上写闸：${error?.message || error}`);
  }
  let parsed;
  try {
    parsed = JSON.parse(reply || '{}');
  } catch {
    refuse('写闸回的不是 JSON');
  }
  if (parsed.code !== 0) {
    const reason = parsed.body?.reason || `写闸拒绝（${parsed.code}）`;
    const detail = parsed.body?.detail ? `：${parsed.body.detail}` : '';
    process.stderr.write(`${reason}${detail}\n`);
    process.exit(Number.isInteger(parsed.code) ? parsed.code : 1);
  }
  process.stdout.write(`${JSON.stringify(parsed.body ?? {})}\n`);
}

await main();
