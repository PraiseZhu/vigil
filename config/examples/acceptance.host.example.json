{
  "piCommand": ["pi", "--model", "<model id>", "--thinking", "max"],
  "egressAllow": ["github.com:443", "codeload.github.com:443", "llm-gateway.example.invalid:443"],
  "prbot": {
    "piCommand": ["pi", "--model", "<deepseek-v4.1-flash id>", "--thinking", "high"],
    "reviewCheckPattern": "review",
    "repos": {
      "example-owner/example-repo": {
        "handoff": "watcher",
        "preflight": [".githooks/pre-push"],
        "testLock": true,
        "handoffNew": ["node", "scripts/new.mjs", "--pr", "{pr}"],
        "forbiddenPaths": [".github/workflows/**"]
      },
      "makecindy/cindy": { "handoff": "watcher" }
    }
  }
}
