{
  "authors": ["ExampleUser", "app/example-qa"],
  "repos": ["example-org/example-repo"],
  "excludeRepos": ["example-org/ignored-repo"],
  "discoverByAuthor": true,
  "stateDir": "steward-state",
  "github": { "mode": "gh" },
  "presence": { "commands": { "ExampleDevice": "false" } },
  "policies": {
    "example-org/example-repo": {
      "trustedReviewers": ["app/example-reviewer"],
      "severityPatterns": {
        "P0": ["\\bP0\\b"],
        "P1": ["\\bP1\\b"],
        "P2": ["\\bP2\\b"],
        "P3": ["\\bP3\\b"]
      },
      "infraPatterns": ["\\bHTTP 5[0-9]{2}\\b", "runner (?:lost|disconnected)"],
      "codeScanning": { "enabled": false, "threshold": "high" },
      "chores": { "followerLogin": "ExampleFollower" }
    }
  }
}
